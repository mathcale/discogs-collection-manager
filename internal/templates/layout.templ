package templates

templ BaseLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.min.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ AppLayout(title string) {
	@BaseLayout(title) {
		<nav class="border-b px-4 py-3 flex gap-6 text-sm font-medium items-center" style="border-color: var(--color-border);">
			<a href="/app/settings" class="hover:underline">Settings</a>
			<a href="/app/scanner" class="hover:underline">Scanner</a>
			<form method="POST" action="/logout" class="ml-auto">
				<button type="submit" class="hover:underline">Log out</button>
			</form>
		</nav>
		{ children... }
	}
}
