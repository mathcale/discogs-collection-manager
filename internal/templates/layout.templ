package templates

templ BaseLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />

			<title>{ title }</title>

			<link rel="stylesheet" href="/static/app.min.css" />

			<script src="/static/htmx.min.js"></script>
			<script>
				function showToast(message, type) {
					var container = document.getElementById('toast-container');

					if (!container) return;

					var toast = document.createElement('div');
					toast.className = 'toast toast-' + (type || 'success');
					toast.textContent = message;

					container.appendChild(toast);

					setTimeout(function() {
						toast.remove();
					}, 3500);
				}
			</script>
		</head>

		<body>
			{ children... }
		</body>
	</html>
}

templ AlertError(msg string) {
	<div class="alert alert-error alert-dismissible mb-4">
		<span>{ msg }</span>

		<button
			type="button"
			class="alert-close"
			aria-label="Dismiss"
			onclick="this.closest('.alert-dismissible').remove()"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
}

templ AppLayout(title string, activePage string) {
	@BaseLayout(title) {
		<nav class="hidden sm:flex border-b px-4 py-3 gap-6 text-sm font-medium items-center" style="border-color: var(--color-border);">
			<a href="/app/scanner" class="hover:underline">Scanner</a>
			<a href="/app/settings" class="hover:underline">Settings</a>
		</nav>

		<nav class="tab-bar sm:hidden" aria-label="Main navigation">
			<a href="/app/scanner" class={ "tab-bar-item", templ.KV("is-active", activePage == "scanner") } aria-label="Scanner">
				@IconScanner("w-5 h-5")
				<span>Scanner</span>
			</a>
			<a href="/app/settings" class={ "tab-bar-item", templ.KV("is-active", activePage == "settings") } aria-label="Settings">
				@IconSettings("w-5 h-5")
				<span>Settings</span>
			</a>
		</nav>

		<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="false"></div>

		<div class="pb-16 sm:pb-0">
			{ children... }
		</div>
	}
}
