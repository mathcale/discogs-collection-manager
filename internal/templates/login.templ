package templates

templ LoginPage(errorMsg string) {
	@BaseLayout("Log in — Discogs Collection Manager") {
		<main class="min-h-screen flex items-center justify-center px-4 py-12">
			<div class="w-full max-w-sm">
				<h1 class="text-3xl font-bold tracking-tight mb-10 text-center">Log in</h1>

				<div class="card">
					<div role="alert" aria-live="polite">
						if errorMsg != "" {
							@AlertError(errorMsg)
						}
					</div>

					<form
						method="POST"
						action="/auth/login"
						hx-boost="true"
						hx-disabled-elt="find button[type='submit']"
					>
						<div class="flex flex-col gap-4">
							<div>
								<label class="block text-sm font-medium mb-1.5" for="email">Email</label>
								<input class="input" type="email" id="email" name="email" required autocomplete="email"/>
							</div>

							<div>
								<label class="block text-sm font-medium mb-1.5" for="password">Password</label>
								<input class="input" type="password" id="password" name="password" required autocomplete="current-password"/>
							</div>

							<label class="flex items-center gap-2 text-sm select-none cursor-pointer">
								<input type="checkbox" name="stay_logged_in" value="1" class="w-4 h-4 rounded"/>
								Stay logged in
							</label>

							<button type="submit" class="btn btn-primary w-full mt-2">
								<span class="spinner mr-1.5" aria-hidden="true"></span>
								Log in
							</button>
						</div>
					</form>
				</div>

				<div class="flex flex-col items-center gap-3 mt-4 text-sm">
					<a href="/forgot-password">Forgot password?</a>
					<a href="/register">No account? Register</a>
				</div>
			</div>
		</main>
	}
}
