package templates

import (
	"strconv"

	"github.com/mathcale/discogs-collection-manager/internal/discogs"
)

templ ScannerPage() {
	@BaseLayout("Scanner — Discogs Collection Manager") {
		<script src="/static/html5-qrcode.min.js"></script>
		<div class="scanner-shell">
			<div class="scanner-viewport">
				<div id="reader"></div>
			</div>
			<div
				id="scan-result"
				class="scan-result"
				aria-live="polite"
				aria-atomic="true"
			></div>
			<div class="scanner-bar" role="toolbar" aria-label="Scanner controls">
				<button id="start-btn" type="button" class="btn btn-primary scanner-bar-btn" hidden>
					Start Scanner
				</button>
				<div id="scan-indicator" class="scan-indicator" aria-hidden="true">
					<span class="spinner"></span>
				</div>
			</div>
		</div>
		<script>
			(function () {
				var submitted = false;
				var resultEl = document.getElementById('scan-result');
				var startBtn = document.getElementById('start-btn');
				var indicator = document.getElementById('scan-indicator');
				var scanner = new Html5Qrcode('reader');
				var config = { fps: 10, qrbox: { width: 250, height: 150 } };

				function postBarcode(barcode) {
					if (submitted) return;
					submitted = true;
					indicator.classList.add('htmx-request');
					htmx.ajax('POST', '/app/scan', {
						target: '#scan-result',
						swap: 'innerHTML',
						values: { barcode: barcode }
					}).finally(function () {
						indicator.classList.remove('htmx-request');
					}).catch(function () { submitted = false; });
				}

				function startScanner() {
					startBtn.hidden = true;
					resultEl.textContent = '';
					return scanner.start(
						{ facingMode: 'environment' },
						config,
						function (decodedText) {
							scanner.stop().catch(function () {});
							postBarcode(decodedText);
						}
					).catch(function (err) {
						startBtn.hidden = false;
						resultEl.textContent = 'Could not start camera: ' + (err && err.message ? err.message : err);
					});
				}

				startBtn.addEventListener('click', startScanner);
				startScanner();
			})();
		</script>
	}
}

templ ScanConfirmPartial(release discogs.Release) {
	<div class="scan-result-card card">
		if release.Thumb != "" {
			<img src={ release.Thumb } alt={ release.Title } class="scan-result-thumb"/>
		}
		<div class="scan-result-body">
			<h2 class="scan-result-title">{ release.Title }</h2>
			<dl class="scan-result-meta">
				if release.Country != "" {
					<dt>Country</dt>
					<dd>{ release.Country }</dd>
				}
				if release.Year != "" {
					<dt>Year</dt>
					<dd>{ release.Year }</dd>
				}
				if release.Label != "" {
					<dt>Label</dt>
					<dd class="scan-result-catno">{ release.Label }</dd>
				}
			</dl>
			<a href={ templ.SafeURL(release.URI) } target="_blank" rel="noopener noreferrer" class="scan-result-link">View on Discogs ↗</a>
		</div>
		<div class="scan-result-actions">
			<form hx-post="/app/scan/confirm" hx-target="#scan-result" hx-swap="innerHTML" hx-disabled-elt="find button[type='submit']">
				<input type="hidden" name="release_id" value={ strconv.Itoa(release.ID) }/>
				<button type="submit" class="btn btn-primary scan-result-action-btn">
					<span class="spinner" aria-hidden="true"></span>
					Add to Collection
				</button>
			</form>
			<a href="/app/scanner" class="btn btn-secondary scan-result-action-btn">Cancel</a>
		</div>
	</div>
}

templ ScanConflictListPartial(releases []discogs.Release) {
	<div class="scan-result-card card">
		<div class="scan-result-body">
			<h2 class="scan-result-title">Multiple releases found</h2>
			<p class="scan-result-subtitle">Select the correct pressing:</p>
		</div>
		<form hx-post="/app/scan/confirm" hx-target="#scan-result" hx-swap="innerHTML" hx-disabled-elt="find button[type='submit']">
			<ul class="scan-conflict-list">
				for _, r := range releases {
					<li class="scan-conflict-item">
						<label class="scan-conflict-label">
							<input type="radio" name="release_id" value={ strconv.Itoa(r.ID) } class="scan-conflict-radio"/>
							if r.Thumb != "" {
								<img src={ r.Thumb } alt={ r.Title } class="scan-conflict-thumb"/>
							}
							<span class="scan-conflict-info">
								<strong>{ r.Title }</strong>
								<span class="scan-conflict-meta">
									if r.Country != "" {
										<span>{ r.Country }</span>
									}
									if r.Year != "" {
										<span>{ r.Year }</span>
									}
									if r.Label != "" {
										<span class="scan-conflict-catno">{ r.Label }</span>
									}
								</span>
								<a href={ templ.SafeURL(r.URI) } target="_blank" rel="noopener noreferrer" class="scan-result-link">View on Discogs ↗</a>
							</span>
						</label>
					</li>
				}
			</ul>
			<div class="scan-result-actions">
				<button type="submit" class="btn btn-primary scan-result-action-btn">
					<span class="spinner" aria-hidden="true"></span>
					Confirm
				</button>
			</div>
		</form>
		<a href="/app/scanner" class="btn btn-secondary scan-result-action-btn">Cancel</a>
	</div>
}

templ ScanSuccessPartial() {
	<div class="scan-result-card alert alert-success" role="status">
		<p>Release added to your Discogs collection!</p>
		<a href="/app/scanner" class="btn btn-primary scan-result-action-btn">Scan another</a>
	</div>
}

templ ScanErrorPartial(message string) {
	<div class="scan-result-card alert alert-error" role="alert">
		<p>{ message }</p>
		<a href="/app/scanner" class="btn btn-secondary scan-result-action-btn">Try again</a>
	</div>
}

templ ScanReconnectPartial() {
	<div class="scan-result-card alert alert-error" role="alert">
		<p>Your Discogs account is no longer connected. Please reconnect to continue.</p>
		<a href="/auth/discogs/connect" class="btn btn-primary scan-result-action-btn">Reconnect Discogs</a>
	</div>
}
