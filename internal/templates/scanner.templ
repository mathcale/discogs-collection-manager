package templates

import (
	"strconv"

	"github.com/mathcale/discogs-collection-manager/internal/discogs"
)

templ ScannerPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Scanner — Discogs Collection Manager</title>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/zxing.min.js"></script>
		</head>
		<body>
			<main>
				<h1>Barcode Scanner</h1>
				<video id="scanner-video" autoplay playsinline style="width:100%;max-width:400px"></video>
				<div id="scan-result"></div>
			</main>
			<script>
				(function () {
					var video = document.getElementById('scanner-video');
					var resultEl = document.getElementById('scan-result');
					var submitted = false;

					function postBarcode(barcode) {
						if (submitted) return;
						submitted = true;
						htmx.ajax('POST', '/app/scan', {
							target: '#scan-result',
							swap: 'innerHTML',
							values: { barcode: barcode }
						}).catch(function () { submitted = false; });
					}

					if (typeof BarcodeDetector !== 'undefined') {
						navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
							.then(function (stream) {
								video.srcObject = stream;
								var detector = new BarcodeDetector();
								var interval = setInterval(function () {
									detector.detect(video).then(function (codes) {
										if (codes.length > 0) {
											clearInterval(interval);
											stream.getTracks().forEach(function (t) { t.stop(); });
											postBarcode(codes[0].rawValue);
										}
									}).catch(function () {});
								}, 300);
							});
					} else {
						var ZXing = window.ZXing;
						var hints = new Map();
						var codeReader = new ZXing.BrowserMultiFormatReader(hints);
						codeReader.decodeFromConstraints(
							{ video: { facingMode: 'environment' } },
							video,
							function (result, err, controls) {
								if (result) {
									controls.stop();
									postBarcode(result.getText());
								}
							}
						);
					}
				})();
			</script>
		</body>
	</html>
}

templ ScanConfirmPartial(release discogs.Release) {
	<div>
		<h2>{ release.Title }</h2>
		if release.Thumb != "" {
			<img src={ release.Thumb } alt={ release.Title }/>
		}
		if release.Country != "" {
			<p>Country: { release.Country }</p>
		}
		if release.Year != "" {
			<p>Year: { release.Year }</p>
		}
		if release.Label != "" {
			<p>Label: { release.Label }</p>
		}
		<p><a href={ templ.SafeURL(release.URI) } target="_blank" rel="noopener noreferrer">View on Discogs</a></p>
		<form hx-post="/app/scan/confirm" hx-target="#scan-result" hx-swap="innerHTML">
			<input type="hidden" name="release_id" value={ strconv.Itoa(release.ID) }/>
			<button type="submit">Add to Collection</button>
		</form>
		<a href="/app/scanner">Cancel</a>
	</div>
}

templ ScanConflictListPartial(releases []discogs.Release) {
	<div>
		<h2>Multiple releases found</h2>
		<p>Select the correct pressing:</p>
		<form hx-post="/app/scan/confirm" hx-target="#scan-result" hx-swap="innerHTML">
			<ul>
				for _, r := range releases {
					<li>
						<label>
							<input type="radio" name="release_id" value={ strconv.Itoa(r.ID) }/>
							if r.Thumb != "" {
								<img src={ r.Thumb } alt={ r.Title }/>
							}
							<strong>{ r.Title }</strong>
							if r.Country != "" {
								<span>{ r.Country }</span>
							}
							if r.Year != "" {
								<span>{ r.Year }</span>
							}
							if r.Label != "" {
								<span>{ r.Label }</span>
							}
							<a href={ templ.SafeURL(r.URI) } target="_blank" rel="noopener noreferrer">View on Discogs</a>
						</label>
					</li>
				}
			</ul>
			<button type="submit">Confirm</button>
		</form>
		<a href="/app/scanner">Cancel</a>
	</div>
}

templ ScanSuccessPartial() {
	<div>
		<p>Release added to your Discogs collection!</p>
		<a href="/app/scanner">Scan another</a>
	</div>
}

templ ScanErrorPartial(message string) {
	<div role="alert">
		<p>{ message }</p>
		<a href="/app/scanner">Try again</a>
	</div>
}
