package templates

templ OTPPage(errorMsg string) {
	@BaseLayout("Verify code — Discogs Collection Manager") {
		<main>
			<h1>Check your email</h1>
			<p>We sent a 6-digit code to your email address. Enter it below to continue.</p>
			if errorMsg != "" {
				<p role="alert">{ errorMsg }</p>
			}
			<form method="POST" action="/login/otp">
				<label for="code">Verification code</label>
				<input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required/>
				<button type="submit">Verify</button>
			</form>
		</main>
	}
}
