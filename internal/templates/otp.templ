package templates

templ OTPPage(errorMsg string) {
	@BaseLayout("Verify code — Discogs Collection Manager") {
		<main class="min-h-screen flex items-center justify-center px-4 py-12">
			<div class="w-full max-w-sm">
				<h1 class="text-2xl font-semibold tracking-tight mb-2 text-center">Check your email</h1>
				<p class="text-sm text-center mb-8" style="color: var(--color-muted)">We sent a 6-digit code to your email address. Enter it below to continue.</p>
				<div class="card">
					<div role="alert" aria-live="polite">
						if errorMsg != "" {
							<div class="alert alert-error mb-4">{ errorMsg }</div>
						}
					</div>
					<form method="POST" action="/login/otp" hx-boost="true" hx-disabled-elt="find button[type='submit']">
						<div class="flex flex-col gap-4">
							<div>
								<label class="block text-sm font-medium mb-1.5" for="code">Verification code</label>
								<input class="input font-mono text-center text-lg tracking-widest" type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required/>
							</div>
							<button type="submit" class="btn btn-primary w-full mt-2">
								<span class="spinner mr-1.5" aria-hidden="true"></span>
								Verify
							</button>
						</div>
					</form>
				</div>
			</div>
		</main>
	}
}
