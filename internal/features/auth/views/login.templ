package views

import "github.com/mathcale/discogs-collection-manager/internal/ui"

templ LoginPage(errorMsg string, signupsEnabled bool) {
	@ui.BaseLayout("Log in — Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">Log in</h1>
				<div class="z-card">
					<div class="z-card-body">
						<div role="alert" aria-live="polite">
							if errorMsg != "" {
								@ui.AlertError(errorMsg)
							}
						</div>
						<form
							method="POST"
							action="/auth/login"
							class="z-form-stacked"
							hx-boost="true"
							hx-disabled-elt="find button[type='submit']"
						>
							<div class="stack">
								<div>
									<label class="z-form-label" for="email">Email</label>
									<input class="z-input" type="email" id="email" name="email" required autocomplete="email"/>
								</div>
								<div>
									<label class="z-form-label" for="password">Password</label>
									<input class="z-input" type="password" id="password" name="password" required autocomplete="current-password"/>
								</div>
								<label class="check-row">
									<input type="checkbox" name="stay_logged_in" value="1" class="z-checkbox"/>
									Stay logged in
								</label>
								<button type="submit" class="z-button z-button-primary">
									@ui.Spinner()
									Log in
								</button>
							</div>
						</form>
					</div>
				</div>
				<div class="page-links">
					<a href="/auth/forgot-password">Forgot password?</a>
					if signupsEnabled {
						<a href="/auth/register">No account? Register</a>
					}
				</div>
			</div>
		</main>
	}
}
