package views

import (
	"github.com/mathcale/discogs-collection-manager/internal/ui/components"
	"github.com/mathcale/discogs-collection-manager/internal/ui/layouts"
)

templ ForgotPasswordPage(sent bool) {
	@layouts.BaseLayout("Forgot password — Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">Forgot password</h1>
				if sent {
					<div class="z-card">
						<div class="z-card-body">
							<div class="z-alert z-alert-success" role="status">
								If an account with that email exists, you'll receive a password reset link shortly.
							</div>
						</div>
					</div>
				} else {
					<div class="z-card">
						<div class="z-card-body">
							<form
								method="POST"
								action="/auth/forgot-password"
								class="z-form-stacked"
								hx-boost="true"
								hx-disabled-elt="find button[type='submit']"
							>
								<div class="stack">
									<div>
										<label class="z-form-label" for="email">Email</label>
										<input class="z-input" type="email" id="email" name="email" required autocomplete="email"/>
									</div>
									<button type="submit" class="z-button z-button-primary">
										@components.Spinner()
										Send reset link
									</button>
								</div>
							</form>
						</div>
					</div>
				}
				<div class="page-links">
					<a href="/auth/login">Back to login</a>
				</div>
			</div>
		</main>
	}
}
