package views

import (
	"github.com/mathcale/discogs-collection-manager/internal/ui/components"
	"github.com/mathcale/discogs-collection-manager/internal/ui/layouts"
)

templ RegisterPage(errorMsg string) {
	@layouts.BaseLayout("Register — Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">Create account</h1>
				<div class="z-card">
					<div class="z-card-body">
						<div role="alert" aria-live="polite">
							if errorMsg != "" {
								@components.AlertError(errorMsg)
							}
						</div>
						<form
							method="POST"
							action="/auth/register"
							class="z-form-stacked"
							hx-boost="true"
							hx-disabled-elt="find button[type='submit']"
						>
							<div class="stack">
								<div>
									<label class="z-form-label" for="email">Email</label>
									<input class="z-input" type="email" id="email" name="email" required autocomplete="email"/>
								</div>
								<div>
									<label class="z-form-label" for="password">Password</label>
									<input class="z-input" type="password" id="password" name="password" required minlength="8" autocomplete="new-password"/>
								</div>
								<button type="submit" class="z-button z-button-primary">
									@components.Spinner()
									Register
								</button>
							</div>
						</form>
					</div>
				</div>
				<div class="page-links">
					<a href="/auth/login">Already have an account? Log in</a>
				</div>
			</div>
		</main>
	}
}
