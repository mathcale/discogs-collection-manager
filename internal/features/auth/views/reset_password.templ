package views

import "github.com/mathcale/discogs-collection-manager/internal/ui"

templ ResetPasswordPage(token, errorMsg string) {
	@ui.BaseLayout("Reset password — Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">Reset password</h1>
				<div class="z-card">
					<div class="z-card-body">
						<div role="alert" aria-live="polite">
							if errorMsg != "" {
								@ui.AlertError(errorMsg)
							}
						</div>
						<form
							method="POST"
							action="/auth/reset-password"
							class="z-form-stacked"
							hx-boost="true"
							hx-disabled-elt="find button[type='submit']"
						>
							<input type="hidden" name="token" value={ token }/>
							<div class="stack">
								<div>
									<label class="z-form-label" for="password">New password</label>
									<input class="z-input" type="password" id="password" name="password" required autocomplete="new-password"/>
								</div>
								<div>
									<label class="z-form-label" for="password_confirm">Confirm new password</label>
									<input class="z-input" type="password" id="password_confirm" name="password_confirm" required autocomplete="new-password"/>
								</div>
								<button type="submit" class="z-button z-button-primary">
									@ui.Spinner()
									Reset password
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</main>
	}
}
