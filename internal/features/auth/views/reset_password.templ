package views

import (
	"github.com/mathcale/discogs-collection-manager/internal/pkg/i18n"
	"github.com/mathcale/discogs-collection-manager/internal/ui/components"
	"github.com/mathcale/discogs-collection-manager/internal/ui/layouts"
)

templ ResetPasswordPage(token, errorMsg string) {
	@layouts.BaseLayout(i18n.T(ctx, "Reset password") + " - Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">{ i18n.T(ctx, "Reset password") }</h1>

				<div class="z-card">
					<div class="z-card-body">
						<div role="alert" aria-live="polite">
							if errorMsg != "" {
								@components.AlertError(errorMsg)
							}
						</div>

						<form
							method="POST"
							action="/auth/reset-password"
							class="z-form-stacked"
							hx-boost="true"
							hx-disabled-elt="find button[type='submit']"
						>
							<input type="hidden" name="token" value={ token }/>

							<div class="stack">
								<div>
									<label class="z-form-label" for="password">
										{ i18n.T(ctx, "New password") }
									</label>

									<input
										class="z-input"
										type="password"
										id="password"
										name="password"
										required
										autocomplete="new-password"
									/>
								</div>

								<div>
									<label class="z-form-label" for="password_confirm">
										{ i18n.T(ctx, "Confirm new password") }
									</label>

									<input
										class="z-input"
										type="password"
										id="password_confirm"
										name="password_confirm"
										required
										autocomplete="new-password"
									/>
								</div>

								<button type="submit" class="z-button z-button-primary">
									@components.Spinner()
									{ i18n.T(ctx, "Reset password") }
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</main>
	}
}
