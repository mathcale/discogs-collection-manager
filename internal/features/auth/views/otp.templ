package views

import "github.com/mathcale/discogs-collection-manager/internal/ui"

templ OTPPage(errorMsg string) {
	@ui.BaseLayout("Verify code — Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">Check your email</h1>
				<p class="page-subtitle">
					We sent a 6-digit code to your email address. Enter it below to continue.
				</p>
				<div class="z-card">
					<div class="z-card-body">
						<div role="alert" aria-live="polite">
							if errorMsg != "" {
								@ui.AlertError(errorMsg)
							}
						</div>
						<form
							method="POST"
							action="/auth/login/otp"
							class="z-form-stacked"
							hx-boost="true"
							hx-disabled-elt="find button[type='submit']"
						>
							<div class="stack">
								<div class="z-text-center">
									<span class="z-form-label">Verification code</span>
									<z-input-pin name="code" length="6" input-mode="numeric" autofocus></z-input-pin>
								</div>
								<button type="submit" class="z-button z-button-primary">
									@ui.Spinner()
									Verify
								</button>
							</div>
						</form>
						<script>
							(function () {
								var form = document.currentScript.closest('.z-card').querySelector('form');
								var pin = form.querySelector('z-input-pin');

								pin.addEventListener('beforeinput', function (event) {
									if (event.data && /\D/.test(event.data)) {
										event.preventDefault();
									}
								}, true);

								pin.addEventListener('paste', function (event) {
									var text = event.clipboardData.getData('text');
									var digits = text.replace(/\D/g, '');

									if (digits === text) {
										return;
									}

									event.preventDefault();
									event.stopPropagation();

									var transfer = new DataTransfer();
									transfer.setData('text', digits);
									event.target.dispatchEvent(new ClipboardEvent('paste', {
										clipboardData: transfer,
										bubbles: true,
										cancelable: true,
									}));
								}, true);

								pin.addEventListener('z-input-pin:change', function (event) {
									if (event.detail.value.length === 6) {
										pin.updateComplete.then(function () {
											form.requestSubmit();
										});
									}
								});
							})();
						</script>
					</div>
				</div>
			</div>
		</main>
	}
}
