package views

import (
	"github.com/mathcale/discogs-collection-manager/internal/ui/components"
	"github.com/mathcale/discogs-collection-manager/internal/ui/layouts"
)

templ SettingsPage(email string, discogsUsername string) {
	@layouts.AppLayout("Settings — Discogs Collection Manager", "settings") {
		<main class="page-settings">
			<h1 class="page-title">Settings</h1>
			<div class="stack">
				<section class="z-card">
					<div class="z-card-header">
						<h2 class="z-card-title">Account</h2>
					</div>
					<div class="z-card-body">
						<dl class="detail">
							<dt>Email</dt>
							<dd>{ email }</dd>
						</dl>
					</div>
				</section>
				<section class="z-card">
					<div class="z-card-header">
						<h2 class="z-card-title">Discogs Connection</h2>
					</div>
					<div class="z-card-body">
						<div id="discogs-status" role="status" aria-live="polite"></div>
						if discogsUsername != "" {
							<div class="stack">
								<div class="status-row">
									<span class="status-dot status-dot-connected" aria-hidden="true"></span>
									<p>
										Connected as <strong>{ discogsUsername }</strong>
									</p>
								</div>
								<form
									method="POST"
									action="/discogs/disconnect"
									hx-boost="true"
									hx-disabled-elt="find button[type='submit']"
									hx-on:htmx:response-error="document.getElementById('discogs-status').innerHTML='<div class=\'z-alert z-alert-danger\'>Disconnection failed. Please try again.</div>'"
								>
									<button type="submit" class="z-button z-button-secondary">
										@components.Spinner()
										Disconnect
									</button>
								</form>
							</div>
						} else {
							<div class="stack">
								<div class="status-row">
									<span class="status-dot" aria-hidden="true"></span>
									<p class="muted">Not connected</p>
								</div>
								<div>
									<a href="/discogs/connect" class="z-button z-button-primary">Connect Discogs account</a>
								</div>
							</div>
						}
					</div>
				</section>
				<section class="z-card">
					<div class="z-card-header">
						<h2 class="z-card-title">Session</h2>
					</div>
					<div class="z-card-body">
						<form method="POST" action="/auth/logout" hx-boost="true" hx-disabled-elt="find button[type='submit']">
							<button type="submit" class="z-button z-button-secondary">
								@components.Spinner()
								Log out
							</button>
						</form>
					</div>
				</section>
			</div>
		</main>
	}
}

templ DiscogsConnectError(message string) {
	@layouts.BaseLayout("Discogs Connection — Discogs Collection Manager") {
		<main class="page-center">
			<div class="page-panel">
				<h1 class="page-title">Connection Failed</h1>
				<div class="z-card">
					<div class="z-card-body stack">
						<div role="alert" aria-live="assertive">
							<div class="z-alert z-alert-danger">{ message }</div>
						</div>
						<a href="/discogs/connect" class="z-button z-button-primary">Try reconnecting</a>
						<a href="/app/settings" class="z-button z-button-secondary">Back to Settings</a>
					</div>
				</div>
			</div>
		</main>
	}
}
