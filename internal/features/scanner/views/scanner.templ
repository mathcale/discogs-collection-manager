package views

import (
	"github.com/mathcale/discogs-collection-manager/internal/pkg/i18n"
	"github.com/mathcale/discogs-collection-manager/internal/ui/components"
	"github.com/mathcale/discogs-collection-manager/internal/ui/layouts"
)

templ ScannerPage() {
	@layouts.AppLayout(i18n.T(ctx, "Scanner") + " - Discogs Collection Manager", "scanner") {
		<div class="scanner-shell">
			<div class="scanner-viewport">
				<div id="reader"></div>

				<div id="camera-error" class="scan-camera-error" role="alert" hidden>
					<svg class="scan-camera-error-icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M1 1l22 22"></path>
						<path d="M21 21H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3m3-3h6l2 3h4a2 2 0 0 1 2 2v9.34m-7.72-2.06a4 4 0 1 1-5.56-5.56"></path>
					</svg>

					<p id="camera-error-title" class="scan-camera-error-title"></p>
					<p id="camera-error-message" class="scan-camera-error-message"></p>
				</div>
			</div>

			<div class="scanner-bar" role="toolbar" aria-label={ i18n.T(ctx, "Scanner controls") }>
				<button id="manual-btn" type="button" class="z-button z-button-large z-button-secondary scanner-bar-btn">
					{ i18n.T(ctx, "Enter manually") }
				</button>
			</div>
		</div>

		<div
			id="result-modal"
			class="z-modal"
			data-z-modal="container: false; bg-close: false; esc-close: false"
			role="dialog"
			aria-modal="true"
			aria-label={ i18n.T(ctx, "Scan result") }
		>
			<div id="scan-result" class="z-modal-dialog scan-dialog-narrow" aria-live="polite" aria-atomic="true"></div>
		</div>

		<div
			id="conflict-modal"
			class="z-modal"
			data-z-modal="container: false; bg-close: false; esc-close: false"
			role="dialog"
			aria-modal="true"
			aria-label={ i18n.T(ctx, "Choose release") }
		>
			<div id="scan-conflict" class="z-modal-dialog" aria-live="polite" aria-atomic="true"></div>
		</div>

		<div
			id="manual-modal"
			class="z-modal"
			data-z-modal="container: false"
			role="dialog"
			aria-modal="true"
			aria-label={ i18n.T(ctx, "Enter barcode") }
		>
			<div class="z-modal-dialog scan-dialog-narrow">
				<form id="manual-form" novalidate>
					<div class="z-modal-header">
						<h2 class="z-modal-title">{ i18n.T(ctx, "Enter barcode") }</h2>
					</div>

					<div class="z-modal-body">
						<input
							type="text"
							id="manual-input"
							name="barcode"
							placeholder={ i18n.T(ctx, "e.g. 5099750442029") }
							class="z-input"
							autocomplete="off"
							data-1p-ignore
							data-lpignore="true"
							data-bwignore
							inputmode="numeric"
							aria-label={ i18n.T(ctx, "Barcode") }
						/>
					</div>

					<div class="z-modal-footer scan-dialog-actions">
						<button type="submit" class="z-button z-button-primary">
							{ i18n.T(ctx, "Search") }
						</button>

						<button type="button" id="manual-close-btn" class="z-button z-button-secondary">
							{ i18n.T(ctx, "Cancel") }
						</button>
					</div>
				</form>
			</div>
		</div>

		<div
			id="cancel-modal"
			class="z-modal"
			data-z-modal="container: false; stack: true; bg-close: false"
			role="dialog"
			aria-modal="true"
			aria-label={ i18n.T(ctx, "Cancel scan") }
		>
			<div class="z-modal-dialog scan-dialog-narrow">
				<div class="z-modal-header">
					<h2 class="z-modal-title">{ i18n.T(ctx, "Cancel this scan?") }</h2>
				</div>

				<div class="z-modal-body">
					<p class="muted">{ i18n.T(ctx, "Your scan result will be discarded.") }</p>
				</div>

				<div class="z-modal-footer scan-dialog-actions">
					<button type="button" id="keep-btn" class="z-button z-button-secondary">
						{ i18n.T(ctx, "Keep reviewing") }
					</button>

					<button type="button" id="confirm-cancel-btn" class="z-button z-button-primary">
						{ i18n.T(ctx, "Yes, cancel") }
					</button>
				</div>
			</div>
		</div>

		<template id="scan-loading-template">
			<div class="scan-loading">
				@components.Spinner()
				<span>{ i18n.T(ctx, "Searching…") }</span>
			</div>
		</template>

		<script>
			function initScanner() {
				var submitted = false;

				var resultModal = document.getElementById('result-modal');
				var conflictModal = document.getElementById('conflict-modal');
				var manualModal = document.getElementById('manual-modal');
				var cancelModal = document.getElementById('cancel-modal');
				var cameraError = document.getElementById('camera-error');
				var cameraErrorTitle = document.getElementById('camera-error-title');
				var cameraErrorMessage = document.getElementById('camera-error-message');
				var scanResult = document.getElementById('scan-result');
				var scanConflict = document.getElementById('scan-conflict');
				var loadingTemplate = document.getElementById('scan-loading-template');
				var manualBtn = document.getElementById('manual-btn');
				var manualForm = document.getElementById('manual-form');
				var manualInput = document.getElementById('manual-input');
				var manualCloseBtn = document.getElementById('manual-close-btn');
				var keepBtn = document.getElementById('keep-btn');
				var confirmCancelBtn = document.getElementById('confirm-cancel-btn');

				var scanner = new Html5Qrcode('reader');
				var config = {
					fps: 10,
					qrbox: { width: 250, height: 150 },
				};

				function showModal(el) {
					zUIkit.modal(el).show();
				}

				function hideModal(el) {
					zUIkit.modal(el).hide();
				}

				function isOpen(el) {
					return el.classList.contains('z-open');
				}

				function stopScanner() {
					if (scanner.getState() === Html5QrcodeScannerState.NOT_STARTED) return;

					scanner.stop().catch(function () {});
				}

				var cameraErrors = {
					NotAllowedError: [{{ i18n.T(ctx, "Camera access blocked") }}, {{ i18n.T(ctx, "Allow camera access in your browser settings and reload the page, or enter the barcode manually.") }}],
					PermissionDeniedError: [{{ i18n.T(ctx, "Camera access blocked") }}, {{ i18n.T(ctx, "Allow camera access in your browser settings and reload the page, or enter the barcode manually.") }}],
					NotFoundError: [{{ i18n.T(ctx, "No camera found") }}, {{ i18n.T(ctx, "We could not find a camera on this device. You can still enter the barcode manually.") }}],
					NotReadableError: [{{ i18n.T(ctx, "Camera unavailable") }}, {{ i18n.T(ctx, "Another app may be using your camera. Close it and reload the page, or enter the barcode manually.") }}],
					OverconstrainedError: [{{ i18n.T(ctx, "Camera unavailable") }}, {{ i18n.T(ctx, "Your camera does not support scanning. You can enter the barcode manually.") }}],
				};

				function showCameraError(err) {
					var text = String(err && err.name ? err.name + ' ' + (err.message || '') : err);
					var key = Object.keys(cameraErrors).find(function (name) { return text.indexOf(name) !== -1; });

					var copy = cameraErrors[key] || [{{ i18n.T(ctx, "Could not start the camera") }}, {{ i18n.T(ctx, "Something went wrong while starting the camera. Reload the page or enter the barcode manually.") }}];

					cameraErrorTitle.textContent = copy[0];
					cameraErrorMessage.textContent = copy[1];
					cameraError.hidden = false;
				}

				function startScanner() {
					return scanner.start(
						{ facingMode: 'environment' },
						config,
						function (decodedText) {
							stopScanner();
							postBarcode(decodedText);
						}
					).then(function () {
						cameraError.hidden = true;
					}).catch(function (err) {
						showCameraError(err);
					});
				}

				function resetScan() {
					hideModal(resultModal);
					hideModal(conflictModal);

					scanResult.innerHTML = '';
					scanConflict.innerHTML = '';
					submitted = false;

					startScanner();
				}

				function postBarcode(barcode) {
					if (submitted) return;

					submitted = true;

					scanResult.replaceChildren(loadingTemplate.content.cloneNode(true));
					showModal(resultModal);

					htmx.ajax('POST', '/app/scan', {
						target: '#scan-result',
						swap: 'innerHTML',
						values: { barcode },
					}).then(function () {
						if (scanResult.querySelector('.scan-loading')) {
							submitted = false;

							hideModal(resultModal);
							startScanner();

							return;
						}

						if (scanResult.querySelector('.scan-conflict-list')) {
							while (scanResult.firstChild) {
								scanConflict.appendChild(scanResult.firstChild);
							}

							hideModal(resultModal);
							showModal(conflictModal);
						}
					}).catch(function () {
						submitted = false;
						hideModal(resultModal);
					});
				}

				[resultModal, conflictModal].forEach(function (modal) {
					modal.addEventListener('click', function (e) {
						if (e.target === modal) showModal(cancelModal);
					});
				});

				document.addEventListener('click', function (e) {
					var link = e.target.closest('a[href="/app/scanner"]');

					if (link && (isOpen(resultModal) || isOpen(conflictModal))) {
						e.preventDefault();
						showModal(cancelModal);
					}
				});

				document.addEventListener('htmx:afterSwap', function () {
					if (scanResult.querySelector('.scan-owned-warning')) {
						hideModal(conflictModal);
						showModal(resultModal);
					}
				});

				keepBtn.addEventListener('click', function () {
					hideModal(cancelModal);
				});

				confirmCancelBtn.addEventListener('click', function () {
					hideModal(cancelModal);
					resetScan();
				});

				manualBtn.addEventListener('click', function () {
					showModal(manualModal);
					manualInput.focus();
				});

				manualCloseBtn.addEventListener('click', function () {
					hideModal(manualModal);
				});

				manualForm.addEventListener('submit', function (e) {
					e.preventDefault();
					var barcode = manualInput.value.trim();
					if (!barcode) return;

					hideModal(manualModal);
					stopScanner();
					manualInput.value = '';

					postBarcode(barcode);
				});

				document.addEventListener('scan-success', resetScan);

				startScanner();
			}

			if (window.Html5Qrcode) {
				initScanner();
			} else {
				var libraryScript = document.createElement('script');

				libraryScript.src = '/static/html5-qrcode.min.js';
				libraryScript.onload = initScanner;

				document.head.appendChild(libraryScript);
			}
		</script>
	}
}
