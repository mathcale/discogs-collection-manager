package views

templ LandingPage() {
	@BaseLayout("Discogs Collection Manager") {
		<main class="min-h-screen flex items-center justify-center px-4 py-12">
			<div class="w-full max-w-sm text-center">
				<h1 class="text-3xl font-semibold tracking-tight mb-3">
					Discogs Collection Manager
				</h1>

				<p class="text-sm mb-8" style="color: var(--color-muted)">
					Connect your Discogs account to start scanning your vinyl collection.
				</p>

				<div class="flex flex-col gap-3">
					<a href="/auth/login" class="btn btn-primary">Log in</a>
					<a href="/auth/register" class="btn btn-secondary">Create account</a>
				</div>
			</div>
		</main>
	}
}
