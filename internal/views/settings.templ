package views

templ SettingsPage(email string, discogsUsername string) {
	@AppLayout("Settings — Discogs Collection Manager", "settings") {
		<main class="px-4 py-8 pb-20 sm:pb-8 max-w-2xl mx-auto">
			<h1 class="text-2xl font-semibold tracking-tight mb-8">Settings</h1>

			<div class="flex flex-col gap-6">
				<section class="card">
					<h2 class="text-base font-semibold mb-4">Account</h2>

					<dl class="flex flex-col gap-2 text-sm">
						<div class="flex flex-col gap-0.5">
							<dt class="font-medium" style="color: var(--color-muted)">Email</dt>
							<dd>{ email }</dd>
						</div>
					</dl>
				</section>

				<section class="card">
					<h2 class="text-base font-semibold mb-4">Discogs Connection</h2>

					<div id="discogs-status" role="status" aria-live="polite" class="mb-4 empty:mb-0"></div>

					if discogsUsername != "" {
						<div class="flex flex-col gap-4">
							<div class="flex items-center gap-3">
								<span class="inline-flex items-center justify-center w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: var(--color-success-fg);" aria-hidden="true"></span>

								<p class="text-sm">
									Connected as <strong class="font-semibold">{ discogsUsername }</strong>
								</p>
							</div>

							<form
								method="POST"
								action="/discogs/disconnect"
								hx-boost="true"
								hx-disabled-elt="find button[type='submit']"
								class="flex"
								hx-on:htmx:response-error="document.getElementById('discogs-status').innerHTML='<div class=\'alert alert-error\'>Disconnection failed. Please try again.</div>'"
							>
								<button type="submit" class="btn btn-secondary">
									<span class="spinner mr-1.5" aria-hidden="true"></span>
									Disconnect
								</button>
							</form>
						</div>
					} else {
						<div class="flex flex-col gap-4">
							<div class="flex items-center gap-3">
								<span class="inline-flex items-center justify-center w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: var(--color-muted);" aria-hidden="true"></span>

								<p class="text-sm" style="color: var(--color-muted)">Not connected</p>
							</div>

							<a href="/discogs/connect" class="btn btn-primary self-start">Connect Discogs account</a>
						</div>
					}
				</section>

				<section class="card">
					<h2 class="text-base font-semibold mb-4">Session</h2>
					<form method="POST" action="/auth/logout" hx-boost="true" hx-disabled-elt="find button[type='submit']">
						<button type="submit" class="btn btn-secondary">
							<span class="spinner mr-1.5" aria-hidden="true"></span>
							Log out
						</button>
					</form>
				</section>
			</div>
		</main>
	}
}

templ DiscogsConnectError(message string) {
	@BaseLayout("Discogs Connection — Discogs Collection Manager") {
		<main class="min-h-dvh flex items-center justify-center px-4 py-12">
			<div class="w-full max-w-sm">
				<h1 class="text-2xl font-semibold tracking-tight mb-8 text-center">
					Connection Failed
				</h1>

				<div class="card flex flex-col gap-4">
					<div role="alert" aria-live="assertive">
						<div class="alert alert-error">{ message }</div>
					</div>

					<div class="flex flex-col gap-2">
						<a href="/discogs/connect" class="btn btn-primary w-full">Try reconnecting</a>
						<a href="/app/settings" class="btn btn-secondary w-full">Back to Settings</a>
					</div>
				</div>
			</div>
		</main>
	}
}
