package views

templ ForgotPasswordPage(sent bool) {
	@BaseLayout("Forgot password — Discogs Collection Manager") {
		<main class="min-h-dvh flex items-center justify-center px-4 py-12">
			<div class="w-full max-w-sm">
				<h1 class="text-3xl font-bold tracking-tight mb-10 text-center">
					Forgot password
				</h1>

				if sent {
					<div class="card">
						<div class="alert alert-success" role="status">
							If an account with that email exists, you'll receive a password reset link shortly.
						</div>
					</div>

					<p class="text-center text-sm mt-4">
						<a href="/auth/login">Back to login</a>
					</p>
				} else {
					<div class="card">
						<form
							method="POST"
							action="/auth/forgot-password"
							hx-boost="true"
							hx-disabled-elt="find button[type='submit']"
						>
							<div class="flex flex-col gap-4">
								<div>
									<label class="block text-sm font-medium mb-1.5" for="email">Email</label>
									<input class="input" type="email" id="email" name="email" required autocomplete="email"/>
								</div>

								<button type="submit" class="btn btn-primary w-full mt-2">
									<span class="spinner mr-1.5" aria-hidden="true"></span>
									Send reset link
								</button>
							</div>
						</form>
					</div>

					<p class="text-center text-sm mt-4">
						<a href="/auth/login">Back to login</a>
					</p>
				}
			</div>
		</main>
	}
}
