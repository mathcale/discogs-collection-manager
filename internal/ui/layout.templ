package ui

templ BaseLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />

			<title>{ title }</title>

			<script>
				(function() {
					var query = window.matchMedia('(prefers-color-scheme: dark)');

					function applyColorScheme() {
						document.documentElement.classList.toggle('dark', query.matches);
					}

					applyColorScheme();
					query.addEventListener('change', applyColorScheme);
				})();
			</script>

			<link rel="stylesheet" href="/static/vendor/0build/kit.min.css" />
			<link rel="stylesheet" href="/static/app.css" />
			<noscript><style>.z-not-ready { opacity: 1; visibility: visible; }</style></noscript>

			<meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":false,"error":true},{"code":"...","swap":true}]}'/>
			<script src="/static/htmx.min.js"></script>
			<script>
				document.addEventListener('htmx:beforeSwap', function(e) {
					var contentType = e.detail.xhr.getResponseHeader('Content-Type') || '';

					if (e.detail.isError && contentType.indexOf('text/html') === 0) {
						e.detail.shouldSwap = true;
						e.detail.isError = false;
					}
				});

				document.addEventListener('htmx:responseError', function() {
					zUIkit.notification({ message: 'Something went wrong. Please try again.', status: 'danger' });
				});

				document.addEventListener('toast', function(e) {
					zUIkit.notification({ message: e.detail.message, status: e.detail.status });
				});
			</script>
		</head>

		<body class="z-not-ready">
			{ children... }

			<script src="/static/vendor/0build/uikit.min.js"></script>
			<script src="/static/vendor/0build/pin.min.js" type="module"></script>
			<script>
				document.body.classList.replace('z-not-ready', 'z-ready');
			</script>
		</body>
	</html>
}

templ AlertError(msg string) {
	<div class="z-alert z-alert-danger alert-spaced" data-z-alert>
		<button type="button" class="z-alert-close" data-z-close aria-label="Dismiss"></button>
		<p>{ msg }</p>
	</div>
}

templ AppLayout(title string, activePage string) {
	@BaseLayout(title) {
		<nav class="app-nav" aria-label="Main navigation">
			<ul class="z-nav z-nav-default app-nav-list">
				<li class={ templ.KV("z-active", activePage == "scanner") }><a href="/app/scanner">Scanner</a></li>
				<li class={ templ.KV("z-active", activePage == "settings") }><a href="/app/settings">Settings</a></li>
			</ul>
		</nav>

		<nav class="tab-bar" aria-label="Main navigation">
			<a href="/app/scanner" class={ "tab-bar-item", templ.KV("is-active", activePage == "scanner") } aria-label="Scanner">
				@IconScanner("")
				<span>Scanner</span>
			</a>
			<a href="/app/settings" class={ "tab-bar-item", templ.KV("is-active", activePage == "settings") } aria-label="Settings">
				@IconSettings("")
				<span>Settings</span>
			</a>
		</nav>

		{ children... }
	}
}

templ Spinner() {
	<span class="z-spinner" aria-hidden="true">
		<svg width="16" height="16" viewBox="0 0 30 30">
			<circle fill="none" stroke="currentColor" cx="15" cy="15" r="14"></circle>
		</svg>
	</span>
}
